<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TB Show - Interactive Battleship</title>
  
  <!-- Fonts & Confetti -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;700;800;900&family=Big+Shoulders+Inline:wght@800;900&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  
  <style>
    :root {
      --tb-wine: #800020;
      --tb-crimson: #B22222;
      --tb-bright-red: #E60000;
      --tb-wine-glow: rgba(178, 34, 34, 0.45);
      --tb-gold: #D4AF37;
      --tb-gold-light: #F3E5AB;
      --tb-card-bg: rgba(13, 3, 6, 0.90);
      --tb-border: rgba(178, 34, 34, 0.45);
      --text-white: #FFFFFF;
      --text-muted: #E0C0C6;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }

    /* FOND TRANSPARENT POUR OBS */
    body {
      background-color: transparent !important;
      background-image: none !important;
      font-family: 'Big Shoulders Display', sans-serif;
      color: var(--text-white);
      width: 100vw; height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 12px; overflow: hidden;
    }

    .app-container {
      width: 100%; max-width: 900px; height: 100%; max-height: 520px;
      background: var(--tb-card-bg) !important; border: 2px solid var(--tb-border);
      border-left: 8px solid var(--tb-crimson); border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 20px var(--tb-wine-glow);
      backdrop-filter: blur(10px); display: flex; flex-direction: column;
      justify-content: space-between; padding: 16px; position: relative;
    }

    .header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid var(--tb-border); padding-bottom: 8px;
    }

    .brand-badge { font-family: 'Big Shoulders Inline', sans-serif; font-size: 24px; color: var(--tb-gold); letter-spacing: 2px; text-transform: uppercase; }
    .game-title { font-size: 20px; font-weight: 800; color: var(--text-white); letter-spacing: 1.5px; }
    .stats-badge { font-size: 16px; font-weight: 800; background: rgba(178, 34, 34, 0.3); border: 1px solid var(--tb-crimson); padding: 4px 10px; border-radius: 6px; color: var(--tb-gold-light); }

    .game-body {
      display: flex; gap: 20px; align-items: center; justify-content: center; flex: 1; margin: 10px 0;
    }

    /* Grille de Bataille Navale */
    .grid-container {
      display: grid;
      grid-template-columns: repeat(6, 48px);
      grid-template-rows: repeat(6, 48px);
      gap: 6px;
      background: rgba(0, 0, 0, 0.4);
      padding: 10px;
      border: 1px solid var(--tb-border);
      border-radius: 8px;
    }

    .grid-cell {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(178, 34, 34, 0.3);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 800;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .grid-cell:hover {
      border-color: var(--tb-gold);
      background: rgba(212, 175, 55, 0.1);
    }

    .grid-cell.hit {
      background: rgba(230, 0, 0, 0.4);
      border-color: var(--tb-bright-red);
      color: var(--tb-gold);
    }

    .grid-cell.miss {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
      color: var(--text-muted);
    }

    /* Panneau d'information latéral */
    .side-panel {
      width: 260px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    .info-box {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--tb-border);
      border-radius: 8px;
      padding: 12px;
      font-size: 15px;
      color: var(--text-muted);
      line-height: 1.4;
    }

    .info-box span {
      color: var(--tb-gold);
      font-weight: bold;
    }

    /* Contrôles de tir */
    .chat-simulator { display: flex; gap: 8px; border-top: 1px solid var(--tb-border); padding-top: 10px; }
    .chat-input {
      flex: 1; background: rgba(0, 0, 0, 0.5); border: 1px solid var(--tb-border);
      padding: 8px 12px; border-radius: 6px; color: var(--text-white); font-family: 'Inter', sans-serif; font-size: 14px; outline: none;
      text-transform: uppercase;
    }
    .chat-btn {
      background: linear-gradient(135deg, var(--tb-crimson), var(--tb-wine)); border: 1px solid var(--tb-gold);
      color: var(--text-white); font-family: 'Big Shoulders Display', sans-serif; font-size: 18px; font-weight: 800;
      padding: 0 20px; border-radius: 6px; cursor: pointer; transition: all 0.2s ease;
    }
    .chat-btn:hover { filter: brightness(1.2); }

    /* Overlay Victoire/Défaite */
    .status-overlay {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(13, 3, 6, 0.95); display: flex; flex-direction: column;
      align-items: center; justify-content: center; border-radius: 12px; z-index: 20;
      opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
    }
    .status-overlay.active { opacity: 1; pointer-events: auto; }
    .status-title { font-size: 48px; font-weight: 900; color: var(--tb-gold); letter-spacing: 2px; margin-bottom: 10px; }
    .status-desc { font-size: 20px; color: var(--text-white); margin-bottom: 20px; text-align: center; }
  </style>
</head>
<body>

  <div class="app-container">
    <div class="header">
      <span class="brand-badge">THE BEYOND SHOW</span>
      <span class="game-title">BATAILLE NAVALE</span>
      <span class="stats-badge" id="statsDisplay">TIRS: 0 / 14</span>
    </div>

    <div class="game-body">
      <!-- Grille 6x6 (A à F, 1 à 6) -->
      <div class="grid-container" id="battleGrid">
        <!-- Généré dynamiquement en JS -->
      </div>

      <!-- Panneau latéral d'instructions -->
      <div class="side-panel">
        <div class="info-box">
          <span>OBJECTIF :</span> Couler tous les navires cachés de la flotte ennemie en un minimum de tirs !
        </div>
        <div class="info-box">
          <span>COMMANDES :</span> Tapez une case (ex: <span>A3</span>, <span>D5</span>) dans la barre de tir ou cliquez directement sur la grille.
        </div>
      </div>
    </div>

    <!-- Zone de tir / Saisie -->
    <div class="chat-simulator">
      <input type="text" id="chatInput" class="chat-input" placeholder="Taper une coordonnée (ex: B4)..." autofocus>
      <button class="chat-btn" id="sendBtn">TIRER !</button>
    </div>

    <!-- Status Overlay -->
    <div class="status-overlay" id="statusOverlay">
      <div class="status-title" id="statusTitle">VICTORY!</div>
      <div class="status-desc" id="statusDesc">Flotte ennemie entièrement coulée !</div>
      <button class="chat-btn" onclick="resetGameCloud()">PROCHAINE FLOTTE</button>
    </div>
  </div>

  <!-- FIREBASE & LOGIQUE BATAILLE NAVALE -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getDatabase, ref, set, onValue, get } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Configuration Firebase validée pour la Bataille Navale
    const firebaseConfig = {
      apiKey: "AIzaSyCac49TFDXfO5TsdwJEtVb4lJqOR-JXmg0",
      authDomain: "tbshow-battleship.firebaseapp.com",
      databaseURL: "https://tbshow-battleship-default-rtdb.europe-west1.firebasedatabase.app",
      projectId: "tbshow-battleship",
      storageBucket: "tbshow-battleship.firebasestorage.app",
      messagingSenderId: "983925650043",
      appId: "1:983925650043:web:736ccbda01757d7b1228de"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    const ROWS = ['A', 'B', 'C', 'D', 'E', 'F'];
    const COLS = [1, 2, 3, 4, 5, 6];
    const MAX_TRIES = 14;

    // Générateur audio synthétique (Son d'explosion ou de plouf)
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playSound(type) {
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain);
      gain.connect(audioCtx.destination);

      if (type === 'hit') { // Explosion
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(150, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(40, audioCtx.currentTime + 0.3);
        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.3);
        osc.start(); osc.stop(audioCtx.currentTime + 0.3);
      } else { // Plouf (Raté)
        osc.type = 'sine';
        osc.frequency.setValueAtTime(300, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(600, audioCtx.currentTime + 0.2);
        gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
        osc.start(); osc.stop(audioCtx.currentTime + 0.2);
      }
    }

    // Création visuelle de la grille
    function buildGridUI() {
      const grid = document.getElementById('battleGrid');
      grid.innerHTML = '';
      ROWS.forEach(row => {
        COLS.forEach(col => {
          const cellId = `${row}${col}`;
          const cell = document.createElement('div');
          cell.className = 'grid-cell';
          cell.id = `cell-${cellId}`;
          cell.innerText = cellId;
          cell.onclick = () => processShot(cellId);
          grid.appendChild(cell);
        });
      });
    }

    // Écouteur Firebase en temps réel
    const gameRef = ref(db, 'battleship_game');
    onValue(gameRef, (snapshot) => {
      const data = snapshot.val();
      if (data) {
        updateUI(data);
        checkStatus(data);
      } else {
        resetGameCloud();
      }
    });

    function updateUI(data) {
      const shots = data.shots || {};
      const ships = data.ships || [];
      let totalShots = Object.keys(shots).length;

      document.getElementById('statsDisplay').innerText = `TIRS: ${totalShots} / ${MAX_TRIES}`;

      ROWS.forEach(row => {
        COLS.forEach(col => {
          const id = `${row}${col}`;
          const cell = document.getElementById(`cell-${id}`);
          cell.className = 'grid-cell';
          cell.innerText = id;

          if (shots[id]) {
            if (ships.includes(id)) {
              cell.classList.add('hit');
              cell.innerText = '💥';
            } else {
              cell.classList.add('miss');
              cell.innerText = '🌊';
            }
          }
        });
      });
    }

    window.processShot = function(target) {
      const cleanTarget = target.trim().toUpperCase();
      if (!ROWS.includes(cleanTarget[0]) || !COLS.includes(parseInt(cleanTarget[1]))) return;

      get(gameRef).then((snapshot) => {
        const data = snapshot.val() || { shots: {}, ships: [] };
        let shots = data.shots || {};
        
        if (shots[cleanTarget]) return; // Déjà tiré ici

        shots[cleanTarget] = true;
        const isAHit = data.ships.includes(cleanTarget);

        if (isAHit) playSound('hit');
        else playSound('miss');

        set(gameRef, {
          ships: data.ships,
          shots: shots
        });
      });
    }

    function checkStatus(data) {
      const ships = data.ships || [];
      const shots = data.shots || {};
      
      const allSunk = ships.every(ship => shots[ship]);
      const totalShots = Object.keys(shots).length;

      const overlay = document.getElementById('statusOverlay');
      if (allSunk && ships.length > 0) {
        confetti({ particleCount: 120, spread: 80, origin: { y: 0.6 } });
        document.getElementById('statusTitle').innerText = "VICTORY!";
        document.getElementById('statusDesc').innerText = `Flotte ennemie coulée en ${totalShots} tirs !`;
        overlay.classList.add('active');
      } else if (totalShots >= MAX_TRIES && !allSunk) {
        document.getElementById('statusTitle').innerText = "DEFEAT";
        document.getElementById('statusDesc').innerText = `Munitions épuisées ! Les navires ont échappé.`;
        overlay.classList.add('active');
      } else {
        overlay.classList.remove('active');
      }
    }

    window.resetGameCloud = function() {
      let ships = [];
      while(ships.length < 5) {
        const randomRow = ROWS[Math.floor(Math.random() * ROWS.length)];
        const randomCol = COLS[Math.floor(Math.random() * COLS.length)];
        const coord = `${randomRow}${randomCol}`;
        if (!ships.includes(coord)) ships.push(coord);
      }

      set(gameRef, {
        ships: ships,
        shots: {}
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      buildGridUI();

      document.getElementById('sendBtn').addEventListener('click', () => {
        const input = document.getElementById('chatInput');
        processShot(input.value);
        input.value = '';
      });

      document.getElementById('chatInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') {
          const input = document.getElementById('chatInput');
          processShot(input.value);
          input.value = '';
        }
      });
    });
  </script>
</body>
</html>
